#!/bin/bash

# Pathless RK3566：仅在 sprd-mtty 存在且 status=okay 时启用。
# status=disabled 时节点目录仍在；current 关掉 uwe-bsp/sdmmc1 后
# sprdbt_tty 会在 get_loopcheck_status 空指针 oops。
mtty_status=""
if [[ -f /proc/device-tree/sprd-mtty/status ]]; then
	mtty_status="$(tr -d '\0' </proc/device-tree/sprd-mtty/status)"
fi
if [[ ! -d /proc/device-tree/sprd-mtty ]] || [[ "${mtty_status}" == "disabled" ]]; then
	exit 0
fi

modprobe -a sprdbt_tty sprdwl_ng
rfkill unblock all
/usr/bin/hciattach_pathless -n -s 1500000 /dev/ttyBT0 sprd

exit 0
