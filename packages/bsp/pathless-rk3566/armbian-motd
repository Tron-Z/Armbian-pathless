# Pathless MOTD — Orange Pi layout (header + sysinfo + updates).
# Disable Armbian-only extra scripts so IP/sysinfo is not printed twice.

MOTD_DISABLE="clear ap-info ip-info containers-info tips commands"
ONE_WIRE=""
HIDE_IP_PATTERN="^dummy0|^lo"
PRIMARY_INTERFACE="$(ls -1 /sys/class/net/ 2>/dev/null | grep -v lo | grep -E "enp|eth|end|enu" | head -1)"
PRIMARY_DIRECTION="rx"
STORAGE=/dev/sda1

CPU_TEMP_OFFSET=0
CPU_TEMP_LIMIT=60
HDD_TEMP_LIMIT=60
AMB_TEMP_LIMIT=40
