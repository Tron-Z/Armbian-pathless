#!/bin/bash
#
# Pathless first login: Orange Pi model — image already has user/password.
# Do not run Armbian's interactive wizard (root password, new user, locale).
#
# Armbian chmod -x /etc/update-motd.d/* until firstlogin; we skip the wizard,
# so restore MOTD here (header + sysinfo + IP) for console/SSH.

chmod +x /etc/update-motd.d/* 2>/dev/null || true

if [[ -f /root/.not_logged_in_yet ]] && tty -s; then
	echo -e "New to Pathless?\n"
	rm -f /root/.not_logged_in_yet
	sync -f /root 2>/dev/null || sync
fi
