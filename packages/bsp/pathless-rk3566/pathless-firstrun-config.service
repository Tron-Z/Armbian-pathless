[Unit]
Description=Pathless first run optional user configuration
Wants=network-online.target
After=network.target network-online.target
ConditionPathExists=/boot/pathless_first_run.txt
ConditionPathExists=/root/.not_logged_in_yet

[Service]
Type=idle
RemainAfterExit=yes
ExecStart=/usr/lib/pathless/pathless-firstrun-config
TimeoutStartSec=2min

[Install]
WantedBy=multi-user.target
